# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Nextfi Software
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# Public browser-safe values for the dedicated Nextfi Software project.
NEXT_PUBLIC_SUPABASE_URL=https://ytzjrztxmnhqtokycenw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qh0SlTq7YvYWDCN3r9WlGA_vrwO-tVr

# Server-only. Copy this from Supabase Settings > API Keys.
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=sb_secret_...

# Google user sign-in is configured in:
# Supabase > Authentication > Providers > Google
# Put the Google OAuth Client ID and Client Secret in Supabase, not in this file.
# Local callback:
# http://localhost:3000/auth/callback

# ------------------------------------------------------------
# AI providers
# ------------------------------------------------------------
# Free plan: all explicitly verified free endpoints are available, with Auto
# choosing the best healthy endpoint for each request.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
MISTRAL_API_KEY=

# Optional paid-plan providers. Leave blank to disable that provider.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Bring Your Own API (BYOK)
# ------------------------------------------------------------
# Required before users can save their own provider API keys.
# Generate once with: openssl rand -base64 32
# Keep the real value server-only and stable across deployments.
NEXTFI_CREDENTIAL_ENCRYPTION_KEY=
# Legacy fallback accepted during migration:
# VROMPT_CREDENTIAL_ENCRYPTION_KEY=

# Optional abuse/safety limits for BYOK requests.
BYOK_DAILY_LIMIT=100
BYOK_MONTHLY_LIMIT=1000
BYOK_RATE_PER_MINUTE=10
BYOK_CONCURRENCY=2
BYOK_MAX_INPUT_CHARS=64000
BYOK_MAX_CONTEXT=128000
BYOK_MAX_OUTPUT=8192
BYOK_MAX_FILES=5
BYOK_MAX_FILE_BYTES=10000000
BYOK_MAX_DURATION_SECONDS=120

# ------------------------------------------------------------
# Payments / PayMongo
# ------------------------------------------------------------
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
PAYMONGO_CHECKOUT_EXPIRY_HOURS=24
PAYMONGO_CHECKOUT_RATE_LIMIT_PER_HOUR=5

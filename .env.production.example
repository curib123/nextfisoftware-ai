NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://vrompt-ai-workplace-web.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://ytzjrztxmnhqtokycenw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qh0SlTq7YvYWDCN3r9WlGA_vrwO-tVr
# Server-only. Never expose this as a NEXT_PUBLIC variable.
SUPABASE_SECRET_KEY=sb_secret_...

# Google user login is configured in Supabase Auth > Providers > Google.
# Do not put the Google OAuth client secret in a NEXT_PUBLIC variable.

# Shared Vrompt AI providers.
# Free: healthy NVIDIA hosted endpoints + Mistral fallback.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
MISTRAL_API_KEY=

# Optional paid/shared providers.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# User BYO API keys are encrypted with this server-only master key.
# Generate once with: openssl rand -base64 32
# Keep the value stable across deployments or saved user keys cannot be decrypted.
VROMPT_CREDENTIAL_ENCRYPTION_KEY=

BYOK_DAILY_LIMIT=100
BYOK_MONTHLY_LIMIT=1000
BYOK_RATE_PER_MINUTE=10
BYOK_CONCURRENCY=2
BYOK_MAX_INPUT_CHARS=64000
BYOK_MAX_CONTEXT=128000
BYOK_MAX_OUTPUT=8192
BYOK_MAX_FILES=5
BYOK_MAX_FILE_BYTES=10000000
BYOK_MAX_DURATION_SECONDS=120

PAYMONGO_MODE=live
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
PAYMONGO_CHECKOUT_EXPIRY_HOURS=24
PAYMONGO_CHECKOUT_RATE_LIMIT_PER_HOUR=5

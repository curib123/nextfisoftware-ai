limit_req_zone $binary_remote_addr zone=vrompt_api:10m rate=10r/s;

upstream vrompt_web {
  server vrompt-web:3000;
}

server {
  listen 80;
  server_name ${VROMPT_DOMAIN} www.${VROMPT_DOMAIN};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name ${VROMPT_DOMAIN} www.${VROMPT_DOMAIN};

  ssl_certificate ${VROMPT_TLS_CERT_PATH};
  ssl_certificate_key ${VROMPT_TLS_KEY_PATH};
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  ssl_session_cache shared:TLS:10m;
  ssl_session_tickets off;

  client_max_body_size 12m;
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types application/json application/javascript text/css text/plain text/xml;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location /api/ {
    limit_req zone=vrompt_api burst=20 nodelay;
    proxy_pass http://vrompt_web;
    proxy_http_version 1.1;
    proxy_read_timeout 180s;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }

  location /_next/static/ {
    proxy_pass http://vrompt_web;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    proxy_pass http://vrompt_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
}

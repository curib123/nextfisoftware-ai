{
  "name": "vrompt",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vrompt/web",
    "build": "npm run build --workspace @vrompt/web",
    "lint": "npm run lint --workspace @vrompt/web",
    "typecheck": "npm run typecheck --workspace @vrompt/web",
    "test": "npm run test --workspace @vrompt/web",
    "test:e2e": "npm run test:e2e --workspace @vrompt/web",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "clean": "npm run clean --workspace @vrompt/web"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
